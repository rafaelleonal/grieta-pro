# Copia este archivo a .env o .env.local y agrega tus valores reales.
# Si ya usas .env, edítalo allí: .env.local tiene prioridad.
# Las claves de ejemplo de los comentarios NO son válidas.
# Estas variables son privadas: no agregues el prefijo NEXT_PUBLIC_.
# Guía de configuración de Elociencia: docs/provider-setup.md
# Base alojada y migraciones: docs/database-deployment.md

# Clave de OpenRouter para usar la conexión del servidor.
# Ejemplo de formato: sk-or-v1-tu_clave_de_openrouter
# También puedes dejarla vacía y escribir tu clave en Conexión en la app.
OPENROUTER_API_KEY=

# Acceso común durante la beta. Conserva cuentas, cuotas y límites de gasto.
# Todos usan los presupuestos administrados de la política base FREE,
# sin cupo mensual de builds; capturas, ritmo y concurrencia conservan sus límites.
# Todos los modelos compatibles, sin búsqueda web. No cambia filas históricas.
# APP_ACCESS_MODE=plans restaura temporalmente el comportamiento Free/Pro anterior.
APP_ACCESS_MODE=beta

# Gemini 3.8 Flash por defecto, con respuesta reducida y razonamiento bajo.
# Opus 5.5 sigue disponible: anthropic/claude-opus-5.5.
# No se aceptan IDs arbitrarios. Confirma disponibilidad en OpenRouter.
OPENROUTER_MODEL=google/gemini-3.8-flash

# Laminar Cloud opcional: métricas sin prompts, respuestas, fotos ni datos de cuenta.
# El envío ocurre después de responder. Ver docs/laminar.md.
LAMINAR_ENABLED=false
# Preferir una clave limitada a ingestión para runtime.
LMNR_PROJECT_API_KEY=
# Clave de proyecto separada, sólo para publicación explícita de evaluaciones sintéticas.
# No es necesaria en producción. Nunca usar NEXT_PUBLIC_ para estas claves.
LMNR_EVAL_API_KEY=

# Opcional. Clave de Riot para importar una partida ya iniciada por Riot ID.
# Ejemplo de formato: RGAPI-tu_clave_de_riot
# Déjala vacía si solo usarás selección manual, texto o foto.
RIOT_API_KEY=

# PostgreSQL local: inicia `pnpm db:local` y conserva esa terminal abierta.
# Estas credenciales son EXCLUSIVAMENTE para desarrollo local.
# Los nombres de usuario/base se conservan; el cambio de marca no los migra.
# Producción: usa la URL privada de tu proveedor PostgreSQL, con TLS.
# Prisma Postgres: DATABASE_URL es la conexión PostgreSQL pooled del runtime.
# Runtime pg: usa sslmode=verify-full para exigir TLS y verificar el servidor.
# Usa postgres:// o postgresql://; este proyecto no usa prisma+postgres://.
DATABASE_URL=postgresql://cholo_local:cholo_local_dev@127.0.0.1:55439/cholo_coach?schema=public

# Opcional para la CLI: conexión directa para migraciones/administración.
# Ausente en local, la CLI usa DATABASE_URL. No descomentes sin un valor real.
# Prisma CLI 7: usa la conexión direct con sslmode=require&sslaccept=strict.
# Los scripts db:seed/access usan pg: pásales DATABASE_URL direct con verify-full.
# No es necesaria en Vercel si las migraciones se ejecutan por separado.
# DIRECT_URL=

# Secreto privado de al menos 32 caracteres aleatorios.
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL exacta desde donde abrirás la app. En producción exige HTTPS.
# localhost y 127.0.0.1 son orígenes distintos.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Opcional: otros orígenes exactos separados por coma. No admite comodines.
# Para móvil local puedes añadir tu IP privada y ajustar BETTER_AUTH_URL.
BETTER_AUTH_TRUSTED_ORIGINS=

# open = registro público (predeterminado), con invitación opcional.
# invite = beta privada que exige una invitación válida.
# Cambiar el registro no elimina la verificación de correo ni las cuotas.
APP_REGISTRATION_MODE=open

# Datos públicos que aparecerán en /terminos y /privacidad.
# Completa los tres antes de publicar o solicitar una clave Riot de producción.
# Nombre legal de la persona o entidad responsable y domicilio con país.
# El correo debe ser una bandeja real atendida, no sólo un remitente de Resend.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=

# Resend: clave privada y remitente de un dominio que hayas verificado.
# Crea una clave con Sending access restringida al dominio de envío.
# El correo remitente debe pertenecer a ese dominio, no a Gmail/Outlook.
# Formato de clave: re_tu_clave
RESEND_API_KEY=
AUTH_EMAIL_FROM=Elociencia <coach@tu-dominio.com>
# Opcional, solo desarrollo: Mailpit local para verificar flujos sin correos reales.
# No puede usarse en producción. Resend tiene prioridad si hay una clave.
# Buzón web: pnpm mail:local → http://127.0.0.1:55441/; guía docs/local-testing.md.
AUTH_MAILPIT_URL=

# Presupuestos máximos en USD. Contabilizan consumo + reservas pendientes.
# Las ventanas diarias/mensuales se renuevan en UTC.
# Los presupuestos individuales se guardan en Plan, no en estas variables:
# semillas nuevas Free USD 1/día y 1/mes; Pro USD 2/día y 5/mes.
# Habilitación optativa en una base existente: consulta docs/provider-setup.md.
AI_MONTHLY_BUDGET_USD=25
AI_DAILY_BUDGET_USD=5
# Fondos separados para que Free no consuma toda la capacidad de Pro.
AI_FREE_POOL_USD=5
AI_PRO_POOL_USD=20
